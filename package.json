{
  "name": "nextline",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-node.mjs",
    "dev:worker": "wrangler dev",
    "dev:app": "vite --config vite.app.config.ts",
    "build": "npm run build:app && node scripts/build-node.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p worker/core && tsc --noEmit -p app && tsc --noEmit -p node",
    "lint": "eslint .",
    "test": "vitest run",
    "test:d1": "NEXTLINE_TEST_DB=d1 vitest run worker/api/api.test.ts worker/mcp/mcp.test.ts worker/adapters/database.test.ts",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply nextline --local",
    "db:migrate:remote": "wrangler d1 migrations apply nextline --remote",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:d1",
    "build:app": "vite build --config vite.app.config.ts",
    "build:site": "node scripts/build-site.mjs",
    "start": "node dist/server/main.mjs",
    "selfhost:init": "node dist/server/cli.mjs init",
    "selfhost:password": "node dist/server/cli.mjs reset-password",
    "selfhost:token": "node dist/server/cli.mjs rotate-token",
    "selfhost:backup": "node dist/server/cli.mjs backup",
    "selfhost:restore": "node dist/server/cli.mjs restore",
    "dev:cloudflare": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "miniflare": "5.20261006.2-beta",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.150.0"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "22.23.4"
  }
}
